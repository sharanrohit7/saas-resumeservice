{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",                           // Required for path mapping
    "paths": {
      "@prisma-client": ["prisma/generated/prisma"]
    }
  },
  "include": ["src/**/*.ts", "index.ts", "app.ts", "interfaces", "prisma/generated/prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}
